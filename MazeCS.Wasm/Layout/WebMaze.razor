@using MazeCs.Shared
@implements IGridDisplay
@implements IController

<div class="maze" tabindex="0" @onkeydown="HandleKeyDown">
    <div class="maze-content">
        @if (grid.Count > 0)
        {
            @for (int y = 0; y < grid.Count; y++)
            {
                <div class="maze-row">
                    @for (int x = 0; x < grid[y].Count; x++)
                    {
                        <div class="maze-cell @GetCellClasses(grid[y][x], new Vec2d(x, y))"></div>
                    }
                </div>
            }
            <div class="maze-bottom"></div>
        }
        else
        {
            <p>Chargement du labyrinthe...</p>
        }
    </div>
</div>

@code {
    [Parameter]
    public required Maze Maze { get; set; }

    [Parameter]
    public required Player Player { get; set; }

    public Vec2d DirectionPressed { get; private set; } = new Vec2d(0, 0);
    public bool IsCollectPressed { get; private set; } = false;
    public bool IsEscapePressed { get; private set; } = false;

    private List<List<string>> grid = new();
    private Vec2d playerPos = null!;

    protected override void OnParametersSet()
    {
        if (Maze == null || Player == null)
            return;

        grid.Clear();
        var width = Maze.MazeSize.X;
        var height = Maze.MazeSize.Y;
        for (int y = 0; y < height; y++)
        {
            var row = new List<string>();
            for (int x = 0; x < width; x++)
            {
                row.Add(" ");
            }
            grid.Add(row);
        }

        Maze.Draw(this);
        Player.Draw(this);

        StateHasChanged();
    }

    void IGridDisplay.DrawGridCell(Vec2d pos, string content, ConsoleColor _)
    {
        if (content == Player.PlayerSymbol)
        {
            playerPos = pos;
            return;
        }

        if (pos.Y >= 0 && pos.Y < grid.Count && pos.X >= 0 && pos.X < grid[pos.Y].Count)
        {
            grid[pos.Y][pos.X] = content;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        var key = e.Key;
        DirectionPressed = key switch
        {
            "ArrowLeft" or "q" or "Q" => Vec2d.West,
            "ArrowRight" or "d" or "D" => Vec2d.East,
            "ArrowUp" or "z" or "Z" => Vec2d.North,
            "ArrowDown" or "s" or "S" => Vec2d.South,
            _ => new Vec2d(0, 0)
        };
        IsCollectPressed = key == " ";
        IsEscapePressed = key == "Escape";

        if (DirectionPressed != Vec2d.Origin || IsCollectPressed || IsEscapePressed)
        {
            Player.Move(this, out _);
            Maze.Draw(this);
            Player.Draw(this);
            StateHasChanged();
        }
    }

    private string GetCellClasses(string cell, Vec2d pos)
    {
        var classes = new List<string>();

        if (cell == "█")
        {
            classes.Add("wall");
        }
        else if (cell == "★")
        {
            classes.Add("exit");
        }
        else if (cell == "/" || cell == "_")
        {
            classes.Add("door");
            if (cell == "_")
                classes.Add("open");
        }
        else if (cell == ".")
        {
            classes.Add("room");
            classes.Add("items");
        }
        else
        {
            classes.Add("room");
        }

        if (playerPos != null && pos.X == playerPos.X && pos.Y == playerPos.Y)
        {
            classes.Add("player");
        }

        return string.Join(" ", classes);
    }
}

